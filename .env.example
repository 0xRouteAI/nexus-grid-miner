# ---------------------------------------------------------------------------
# NEXUS GRID miner node — one GPU, one model.
#   cp .env.example .env
# NEVER commit or share .env: it holds your private key.
# Keep comments on their own lines; text after a value becomes part of it.
# ---------------------------------------------------------------------------

# --- Required --------------------------------------------------------------

# Network address. A host name is enough; the agent adds wss:// and /ws/miner.
# Example: SERVER_URL=nexus.example.com
SERVER_URL=

# A NEW, dedicated EVM wallet (0x... address; MetaMask, Rabby, OKX Wallet...).
# Points are credited to this address. Never use a wallet that holds assets.
WALLET=

# Private key of WALLET (hex, with or without 0x). Used ONLY to sign the
# registration message on each connect: no transactions, no funds needed.
# It is stored in plain text here, so protect this file: chmod 600 .env
MINER_PRIVATE_KEY=

# The ONE model this GPU serves:
#   bge-m3              text embeddings
#   bge-reranker-v2-m3  reranking
COMPOSE_PROFILES=

# Inference image for YOUR GPU generation (Hugging Face text-embeddings-inference):
#   RTX 20xx / T4 ........... ghcr.io/huggingface/text-embeddings-inference:turing-1.10
#   RTX 30xx / A10 / A40 .... ghcr.io/huggingface/text-embeddings-inference:86-1.10
#   RTX 40xx / L4 / L40 ..... ghcr.io/huggingface/text-embeddings-inference:89-1.10
#   RTX 50xx ................ ghcr.io/huggingface/text-embeddings-inference:120-1.10
#   A100 / A30 .............. ghcr.io/huggingface/text-embeddings-inference:1.10
#   H100 .................... ghcr.io/huggingface/text-embeddings-inference:hopper-1.10
# GTX 10xx / V100 and older are not supported.
TEI_IMAGE=

# --- Recommended -----------------------------------------------------------

# Node name, unique per GPU of the same wallet. If empty, the container id is
# used, so a recreated container shows up as a new node.
NODE_ID=

# Which GPU this node uses (nvidia-smi index). Machines with several GPUs run
# one copy of this folder per GPU, each with its own GPU_DEVICE and NODE_ID.
GPU_DEVICE=0

# --- Optional --------------------------------------------------------------

# Set these only when nvidia-smi cannot detect the GPU.
GPU_MODEL=
VRAM_MB=

MAX_CONCURRENT_TASKS=4

# debug | info | warn | error
LOG_LEVEL=info
